    "kysely": "0.29.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.15.6",
    "dotenv": "17.4.2",
    "kysely-codegen": "0.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
