{
  "name": "@clinica/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camada de acesso: contexto de tenant, tipos do banco e RBAC",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:types": "node scripts/gen-db-types.mjs",
