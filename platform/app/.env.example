# Conexao da aplicacao. O usuario NAO pode ser dono das tabelas nem superusuario:
# ambos ignoram RLS. Use um papel que herde crm_app.
DATABASE_URL="postgresql://crm_test:crm_test@localhost:5432/crm_v2_test"

# Segredo de assinatura da sessao. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-uma-string-aleatoria-de-32-bytes"

# Duracao da sessao (horas) e da exigencia de MFA para dado clinico (minutos).
SESSION_HOURS="12"
MFA_WINDOW_MINUTES="720"
