# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).

# Domínio final do site (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://lakscompany.com.br

# Para onde vão os leads do formulário (Make, Zapier, n8n, RD Station, CRM...). Obrigatório em produção:
# sem ele a API responde 503 e o lead NÃO é entregue.
LEAD_WEBHOOK_URL=
# Opcional: enviado como "Authorization: Bearer <token>" para o webhook validar a origem.
LEAD_WEBHOOK_TOKEN=

# Medição (só carrega após o aviso de cookies). IDs que estão no site atual:
NEXT_PUBLIC_GTM_ID=GTM-W38SHVKL
NEXT_PUBLIC_META_PIXEL_ID=228084868986737
NEXT_PUBLIC_CLARITY_ID=vpn6jwpxro
