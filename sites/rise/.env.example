# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).

# Domínio final do site (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://skillsales.com.br

# Formulário de aplicação (Respondi). Os parâmetros UTM da visita são repassados no link.
NEXT_PUBLIC_FORM_URL=https://form.respondi.app/BPhjlgeA

# Medição (só carrega após o aviso de cookies). IDs que estão no site atual (skillsales.com.br):
NEXT_PUBLIC_GTM_ID=GTM-53D5SPJJ
NEXT_PUBLIC_META_PIXEL_ID=1737553279768220
NEXT_PUBLIC_CLARITY_ID=
