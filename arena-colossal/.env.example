# =============================================================================
# ARENA COLOSSAL — VARIAVEIS DE AMBIENTE
# =============================================================================
# Copie este arquivo para `.env.local` (desenvolvimento) ou configure as mesmas
# chaves no painel da sua hospedagem (producao).
#
# REGRA DE OURO
#   - Tudo que comeca com NEXT_PUBLIC_ e' EMBUTIDO NO BUNDLE DO NAVEGADOR.
#     Nunca coloque segredo nenhum com esse prefixo.
#   - Todas as demais variaveis ficam SOMENTE no servidor.
#
# O site sobe e funciona sem nenhuma destas variaveis preenchidas: o sistema
# entra em "modo degradado" (agendamento gravado em memoria, integracoes
# desligadas) e avisa isso em /api/health. Preencha por etapas.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SITE (publico)
# -----------------------------------------------------------------------------
# URL canonica, sem barra no final. Usada em SEO, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=

# Numero de WhatsApp PUBLICO da Arena (o que o cliente clica no site).
# Formato E.164 apenas com digitos: 55 + DDD + numero. Ex: 5547999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Perfil do Instagram (somente o usuario, sem @ e sem URL). Ex: arenacolossal
NEXT_PUBLIC_INSTAGRAM=

# E-mail publico de contato.
NEXT_PUBLIC_CONTACT_EMAIL=


# -----------------------------------------------------------------------------
# 2. ENDERECO E MAPA (publico) — deixe vazio ate ter o dado REAL
# -----------------------------------------------------------------------------
# Enquanto estiver vazio, o site mostra apenas "Balneario Camboriu — SC" e
# esconde os botoes de rota. Nada e' inventado.
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_DISTRICT=
NEXT_PUBLIC_ADDRESS_CITY=Balneário Camboriú
NEXT_PUBLIC_ADDRESS_STATE=SC
NEXT_PUBLIC_ADDRESS_ZIP=

# Coordenadas para o mapa embutido e para o schema.org. Ex: -26.9906 / -48.6350
NEXT_PUBLIC_LAT=
NEXT_PUBLIC_LNG=

# Place ID do Google (opcional). Habilita links de rota mais precisos e e' a
# chave usada depois para puxar as avaliacoes reais do Google.
NEXT_PUBLIC_GOOGLE_PLACE_ID=


# -----------------------------------------------------------------------------
# 3. HORARIO DE FUNCIONAMENTO / AGENDA (servidor)
# -----------------------------------------------------------------------------
# Fuso horario da operacao (IANA).
BOOKING_TIMEZONE=America/Sao_Paulo

# Janela de atendimento por dia da semana: 0=domingo ... 6=sabado.
# Formato: dia:HH:MM-HH:MM, separado por virgula. Dias ausentes = fechado.
# Deixe VAZIO se o horario real ainda nao foi definido: o site nao inventa
# horario e o agendamento avisa que a agenda ainda nao esta configurada.
BOOKING_HOURS=1:08:00-18:00,2:08:00-18:00,3:08:00-18:00,4:08:00-18:00,5:08:00-18:00,6:08:00-12:00

# Granularidade da grade de horarios, em minutos.
BOOKING_SLOT_MINUTES=30

# Antecedencia minima (horas) e janela maxima (dias) para agendar.
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_MAX_ADVANCE_DAYS=60

# Quantos veiculos a Arena consegue atender no mesmo horario.
BOOKING_CONCURRENCY=1

# Datas bloqueadas (feriados/recesso), YYYY-MM-DD separadas por virgula.
BOOKING_BLACKOUT_DATES=


# -----------------------------------------------------------------------------
# 4. BANCO DE DADOS (servidor)
# -----------------------------------------------------------------------------
# PostgreSQL. Sem esta variavel o sistema usa o driver em memoria — util para
# desenvolvimento, INADEQUADO para producao (os agendamentos somem no restart).
# Ex: postgresql://usuario:senha@host:5432/arena_colossal?schema=public
DATABASE_URL=


# -----------------------------------------------------------------------------
# 5. GOOGLE CALENDAR (servidor — SEGREDOS)
# -----------------------------------------------------------------------------
# Veja README.md > "Google Calendar" para o passo a passo de como gerar o
# refresh token. NUNCA exponha estes valores no frontend.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
# 6. E-MAIL TRANSACIONAL — Resend (servidor — SEGREDO)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Remetente verificado no dominio da Arena. Ex: Arena Colossal <agenda@dominio.com.br>
EMAIL_FROM=
# Caixa que recebe a copia interna de cada agendamento.
EMAIL_TO_INTERNAL=


# -----------------------------------------------------------------------------
# 7. WHATSAPP — Meta WhatsApp Cloud API (servidor — SEGREDOS)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Numero que RECEBE o aviso de novo agendamento (equipe da Arena), E.164 so digitos.
WHATSAPP_NOTIFY_TO=
# Template aprovado na Meta usado quando a janela de 24h esta fechada.
# Deixe vazio para enviar mensagem de texto simples (so funciona dentro da janela).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR


# -----------------------------------------------------------------------------
# 8. ANTI-SPAM — Cloudflare Turnstile
# -----------------------------------------------------------------------------
# Site key e' publica por definicao; a secret key NUNCA vai para o frontend.
# Com as duas vazias, o widget nao aparece e a verificacao e' pulada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 9. ANALYTICS (publico — sao IDs, nao segredos)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=


# -----------------------------------------------------------------------------
# 10. OPERACAO
# -----------------------------------------------------------------------------
# Limite de agendamentos por IP por hora.
RATE_LIMIT_BOOKINGS_PER_HOUR=5
