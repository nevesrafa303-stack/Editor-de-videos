      "text": "mensagens de whatsapp, e-mails do trabalho, e o depoimento de colegas",
      "scale": 1.18,
      "translateX": 0.02,
      "creep": 0,
      "emphasis": false
    },
    {
      "srcStart": 33.1,
      "srcEnd": 37.796,
      "from": 566,
      "durationInFrames": 141,
      "text": "na pratica isso significa que a sua palavra deixa de ser a unica prova",
      "scale": 1,
      "translateX": -0.015,
      "creep": 0,
      "emphasis": false
    },
    {
      "srcStart": 41.9,
      "srcEnd": 45.306,
      "from": 707,
      "durationInFrames": 102,
      "text": "mas atencao existe um prazo e ele corre contra voce",
      "scale": 1.28,
      "translateX": 0,
      "creep": 0,
      "emphasis": true
    },
    {
      "srcStart": 46.3,
      "srcEnd": 48.415,
