# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Segredo usado para assinar o cookie de sessao (troque em producao)
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-por-uma-string-aleatoria-de-32-bytes"

# Duracao da sessao em horas
SESSION_HOURS="12"
